# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git: real secrets must never be committed or written into the code.

# --- Private (server only) ---

# MongoDB connection string, including the database user and password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address the app is served from (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Optional: the user id that `npm run seed:jobs` fills with sample applications.
SEED_USER_ID=

# --- Public (sent to the browser; never put secrets in NEXT_PUBLIC_ values) ---

# Same address as BETTER_AUTH_URL; the sign-in forms call it.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Public address of the site, used for link previews, the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
